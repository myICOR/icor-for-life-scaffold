{
  "$comment": "The structure of an ICOR for Life folder: every type of note, where it lives, its fields, the values a field allows and which types its links point to. Plugins, scripts, skills and any AI read this one file. Change the structure here first.",
  "schema": 1,
  "common": [
    "type",
    "created",
    "tags"
  ],
  "folders": {
    "00 Daily Notes": "your raw writing: one note a day and quick scratch notes; never edited by an AI",
    "01 Inbox": "scans (Scanner Inbox/) and anything not yet sorted",
    "02 My Life": "the map of your life: Key Elements, Goals, Projects, Topics, Habits",
    "03 Journal": "your journal entries, by date",
    "04 Notes": "your knowledge: ideas, outlines, drafts, documents, meetings, highlights",
    "05 Contacts": "people and companies",
    "06 Sources": "what others made: one source note per book, article, video, podcast, post or paper, with your highlights",
    "07 Planner": "tasks synced from your task apps by the Planner plugin",
    "08 Workbench": "work in progress: one dated folder per piece of work, anything goes inside; finished work moves to Done/",
    "09 AI": "your AI's own folder: how it works here (Skills/), what it learned (Memory.md), what it did (Log/) and the weekly reviews (Reviews/)",
    "10 Files": "files only (Images/, Audio/, Documents/), embedded from notes",
    "11 Databases": "Objects.base (every object, a view per type), and data too large or row-shaped for notes; no notes"
  },
  "stages": {
    "input": {
      "label": "Input",
      "color": "#5271FC",
      "folders": [
        "00 Daily Notes",
        "01 Inbox"
      ]
    },
    "control": {
      "label": "Control",
      "color": "#52F49A",
      "folders": [
        "02 My Life",
        "03 Journal",
        "04 Notes",
        "05 Contacts",
        "06 Sources",
        "10 Files",
        "11 Databases"
      ]
    },
    "output": {
      "label": "Output",
      "color": "#FD63FF",
      "folders": [
        "07 Planner",
        "08 Workbench"
      ]
    },
    "refine": {
      "label": "Refine",
      "color": "#FFB547",
      "folders": [
        "09 AI"
      ],
      "about": "09 AI: what your AI did (Log), what it learned (Memory.md) and the weekly reviews (Reviews); the plugins (AI Chat, Connect, Focus) refine too"
    }
  },
  "my_life": [
    "key-element",
    "goal",
    "project",
    "topic",
    "habit"
  ],
  "worlds": {
    "inner": "04 Notes",
    "outer": "06 Sources"
  },
