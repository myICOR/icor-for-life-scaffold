# Generated by _System/Tools/new-base.py
# Columns are fields from _System/schema.json. To change them: the schema,
# then the registry in new-base.py, then re-stamp.
filters:
  and:
    - file.inFolder("02 Inner World/My Life/Topics")
    - file.ext == "md"
    - note.type == "topic"
properties:
  file.name:
    displayName: Name
  note.related_topics:
    displayName: Related
views:
  - type: table
    name: Topics
    order:
      - file.name
      - note.related_topics
    sort:
      - property: file.name
        direction: ASC
