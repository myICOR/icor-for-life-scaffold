# Generated by _System/Tools/new-base.py
# Columns are fields from _System/schema.json. To change them: the schema,
# then the registry in new-base.py, then re-stamp.
filters:
  and:
    - file.inFolder("02 Inner World/Contacts/People")
    - file.ext == "md"
    - note.type == "person"
properties:
  file.name:
    displayName: Name
  note.role:
    displayName: Role
  note.relation:
    displayName: Relation
  note.companies:
    displayName: Companies
  note.email:
    displayName: Email
  note.last_contact:
    displayName: Last contact
  note.next_action:
    displayName: Next action
views:
  - type: table
    name: People
    order:
      - file.name
      - note.role
      - note.relation
      - note.companies
      - note.email
      - note.last_contact
      - note.next_action
    sort:
      - property: file.name
        direction: ASC
