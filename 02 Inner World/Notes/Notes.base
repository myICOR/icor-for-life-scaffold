# Generated by _System/Tools/new-base.py
# Columns are fields from _System/schema.json. To change them: the schema,
# then the registry in new-base.py, then re-stamp.
filters:
  and:
    - file.inFolder("02 Inner World/Notes")
    - file.ext == "md"
    - note.type == "note"
properties:
  file.name:
    displayName: Name
  note.note_type:
    displayName: Kind
  note.projects:
    displayName: Projects
  note.key_elements:
    displayName: Key Elements
  note.topics:
    displayName: Topics
  note.source_url:
    displayName: Source
views:
  - type: table
    name: Notes
    order:
      - file.name
      - note.note_type
      - note.projects
      - note.key_elements
      - note.topics
      - note.source_url
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Open ideas
    filters:
      and:
        - note.note_type == "idea"
        - note.idea_status == "open"
    order:
      - file.name
      - note.key_elements
      - note.projects
      - note.topics
    sort:
      - property: file.name
        direction: ASC
