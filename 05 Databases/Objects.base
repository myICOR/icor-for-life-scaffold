# Every object in one place: all of them, and one view per type. ICOR Objects adds a view for each
# type you add. The bases in the type folders (Projects.base, People.base…) show each type with all its fields.
filters:
  and:
    - file.ext == "md"
    - file.hasProperty("type")
    - not:
        - file.inFolder("_System")
        - file.inFolder("00 Daily Notes")
        - file.inFolder("06 Planner")
properties:
  file.name:
    displayName: "Name"
  note.type:
    displayName: "Type"
  note.created:
    displayName: "Created"
  note.tags:
    displayName: "Tags"
views:
  - type: table
    name: "All objects"
    filters:
      and:
        - note.type != "journal"
        - note.type != "capture"
    order:
      - file.name
      - note.type
      - note.created
    sort:
      - property: note.type
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: "Key Elements"
    filters:
      and:
        - note.type == "key-element"
    order:
      - file.name
      - note.created
      - note.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Goals"
    filters:
      and:
        - note.type == "goal"
    order:
      - file.name
      - note.created
      - note.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Projects"
    filters:
      and:
        - note.type == "project"
    order:
      - file.name
      - note.created
      - note.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Topics"
    filters:
      and:
        - note.type == "topic"
    order:
      - file.name
      - note.created
      - note.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Habits"
    filters:
      and:
        - note.type == "habit"
    order:
      - file.name
      - note.created
      - note.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "People"
    filters:
      and:
        - note.type == "person"
    order:
      - file.name
      - note.created
      - note.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Companies"
    filters:
      and:
        - note.type == "company"
    order:
      - file.name
      - note.created
      - note.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Notes"
    filters:
      and:
        - note.type == "note"
    order:
      - file.name
      - note.created
      - note.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Documents"
    filters:
      and:
        - note.type == "document"
    order:
      - file.name
      - note.created
      - note.tags
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: "Sources"
    filters:
      and:
        - note.type == "source"
    order:
      - file.name
      - note.created
      - note.tags
    sort:
      - property: file.name
        direction: ASC
