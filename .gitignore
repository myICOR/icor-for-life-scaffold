.env
.claude/settings.local.json
.obsidian/workspace-mobile.json
.DS_Store


# Obsidian plugins and themes are installed from Obsidian's community
# directory (search "ICOR for Life"), never tracked and never shipped (2.3.0).
# Their data.json can hold API keys, OAuth tokens and shell environments
# (hard rule 9: secrets never reach git). The release builder blocks a zip
# that carries either folder.
.obsidian/plugins/
.obsidian/themes/


# Live personal data syncs into these paths - never tracked, never shipped
07 Planner/*/
# The AI's record and the work in progress are personal: only the READMEs, Memory.md and the empty folders ship
09 AI/Log/[0-9][0-9][0-9][0-9]/
09 AI/Reviews/[0-9][0-9][0-9][0-9]/
08 Workbench/[0-9][0-9][0-9][0-9]-*/
08 Workbench/Done/[0-9][0-9][0-9][0-9]-*/
00 Daily Notes/2026-*.md
00 Daily Notes/2027-*.md
# ... and the same notes in the YYYY/MM/ shape the scratchpad actually uses
# (GL-1004). The two flat lines above predate the nesting and match nothing;
# link-dates-to-daily-notes.py --fix creates daily notes, and a daily note is
# personal data that must never reach the zip.
00 Daily Notes/[0-9][0-9][0-9][0-9]/


# The machine layer (GL-1008): what plugins and scripts write for each other,
# per device and regenerated, never tracked and never shipped. Only the four
# files that describe the scaffold version are kept.
.icor-for-life/*
!.icor-for-life/VERSION
!.icor-for-life/THIRD-PARTY-NOTICES.md
!.icor-for-life/CHANGELOG.md
!.icor-for-life/README.md
# Named explicitly, though the wildcard above already covers them: per-session
# state written by the checkpoint receipt and the session-start hook. A receipt
# belongs to one session on one device and is never a note (GL-1008).
.icor-for-life/scripts/receipts/
.icor-for-life/scripts/session.json
# The same for the team half: myPKA's session-start hook writes
# .mypka/state/session.json when myPKA shares this folder.
.mypka/state/

# The host link layer, written by scaffold-init.py apply: `.agents/skills/<name>`
# is a link (or, where the platform has no symlinks, a copy) into the canonical
# 06 AI Team/AI Team Knowledge/Skills/. It is per device by construction: the
# generator decides the kind at write time, the manifest describes files by
# content hash and a link has none, and the release zip lists files only. The
# source of truth is tracked; this rendering of it is not.
.agents/skills/
# the same copies for Claude Code; release/build-zip.py makes both from _System/Skills
.claude/skills/
# the release builder's work folders
release/.cache/
release/dist/

# Python bytecode, regenerated on every script run
__pycache__/
*.pyc

# Build caches, written by a tool that was run from this folder and owned by
# that tool, not by the vault. `.build/` is Swift Package Manager's: it drops
# a CACHEDIR.TAG inside saying exactly that, and it appears whenever an Xcode
# or SwiftPM build touches this directory. Its three siblings are named here
# too, so the next one costs nobody a second look at `git status`. Nothing in
# this block is ever a note, and nothing in it ships.
.build/
.swiftpm/
DerivedData/
*.xcuserdatad

# The member's overrides and the updater's own output (Marshall C). Never
# tracked, never shipped; both builders refuse to ship either suffix.
*.local.md
*.update
