# Generated by _System/Tools/new-base.py
# Columns are fields from _System/schema.json. To change them: the schema,
# then the registry in new-base.py, then re-stamp.
filters:
  and:
    - file.inFolder("02 My Life/Habits")
    - file.ext == "md"
    - note.type == "habit"
properties:
  file.name:
    displayName: Name
  note.status:
    displayName: Status
  note.planner_habit:
    displayName: Planner
views:
  - type: table
    name: Habits
    order:
      - file.name
      - note.status
      - note.planner_habit
    sort:
      - property: file.name
        direction: ASC
