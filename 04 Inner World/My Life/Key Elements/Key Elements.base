# Generated by _System/Tools/new-base.py
# Columns are fields from _System/schema.json. To change them: the schema,
# then the registry in new-base.py, then re-stamp.
filters:
  and:
    - file.inFolder("04 Inner World/My Life/Key Elements")
    - file.ext == "md"
    - note.type == "key-element"
properties:
  file.name:
    displayName: Name
  note.goals:
    displayName: Goals
  note.people:
    displayName: People
views:
  - type: table
    name: Key Elements
    order:
      - file.name
      - note.goals
      - note.people
    sort:
      - property: file.name
        direction: ASC
