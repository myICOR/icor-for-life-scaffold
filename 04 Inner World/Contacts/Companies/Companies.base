# Generated by _System/Tools/new-base.py
# Columns are fields from _System/schema.json. To change them: the schema,
# then the registry in new-base.py, then re-stamp.
filters:
  and:
    - file.inFolder("04 Inner World/Contacts/Companies")
    - file.ext == "md"
    - note.type == "company"
properties:
  file.name:
    displayName: Name
  note.industry:
    displayName: Industry
  note.people:
    displayName: People
  note.website:
    displayName: Website
views:
  - type: table
    name: Companies
    order:
      - file.name
      - note.industry
      - note.people
      - note.website
    sort:
      - property: file.name
        direction: ASC
