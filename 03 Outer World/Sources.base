# Generated by _System/Tools/new-base.py
# Columns are fields from _System/schema.json. To change them: the schema,
# then the registry in new-base.py, then re-stamp.
filters:
  and:
    - file.inFolder("03 Outer World")
    - file.ext == "md"
    - note.type == "source"
properties:
  file.name:
    displayName: Name
  note.source_type:
    displayName: Kind
  note.author:
    displayName: Author
  note.topics:
    displayName: Topics
  note.projects:
    displayName: Projects
  note.key_elements:
    displayName: Key Elements
  note.consumed:
    displayName: Consumed
views:
  - type: table
    name: Sources
    order:
      - file.name
      - note.source_type
      - note.author
      - note.topics
      - note.projects
      - note.key_elements
      - note.consumed
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Reading queue
    filters:
      and:
        - note.consumed != true
    order:
      - file.name
      - note.source_type
      - note.author
      - note.topics
    sort:
      - property: file.name
        direction: ASC
